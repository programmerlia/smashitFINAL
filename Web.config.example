<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to Web.config and replace every placeholder with a deployment secret. Never commit Web.config. -->
<configuration>
  <connectionStrings>
    <!-- SQL Server must be reachable from the Windows/IIS host. -->
    <add name="soapergandahannali" connectionString="Server=YOUR_SQL_SERVER;Database=smashit;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False;" providerName="System.Data.SqlClient" />
    <!-- Kept temporarily because some existing pages use this legacy name. -->
    <add name="dbsmashitFINAL" connectionString="Server=YOUR_SQL_SERVER;Database=smashit;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PaymongoSecretKey" value="YOUR_PAYMONGO_SECRET_KEY" />
    <add key="PaymongoWebhookSecret" value="YOUR_PAYMONGO_WEBHOOK_SECRET" />
    <add key="CloudinaryCloudName" value="YOUR_CLOUDINARY_CLOUD_NAME" />
    <add key="CloudinaryApiKey" value="YOUR_CLOUDINARY_API_KEY" />
    <add key="CloudinaryApiSecret" value="YOUR_CLOUDINARY_API_SECRET" />
    <add key="SmtpHost" value="smtp.example.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUsername" value="YOUR_SMTP_USERNAME" />
    <add key="SmtpPassword" value="YOUR_SMTP_PASSWORD" />
    <add key="SmtpFrom" value="no-reply@example.com" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
    <customErrors mode="RemoteOnly" />
  </system.web>
</configuration>
