<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="homepage.master.cs" Inherits="Smash_IT.Site1" %>
<%@ Register Src="~/controls/AuthModal.ascx" TagPrefix="uc" TagName="AuthModal" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smash-It Sports Center</title>
   

     <!-- 1. LOAD JQUERY FIRST -->
 <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 
 <!-- 2. THEN BOOTSTRAP -->
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

 <!-- Global CSS / Fonts -->
 <script src="https://cdn.tailwindcss.com"></script>
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
 <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Your global styles -->
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/header.css">
    <link rel="stylesheet" href="~/css/hero.css">
    <link rel="stylesheet" href="~/css/reserve.css">
    <link rel="stylesheet" href="~/css/promos.css">
    <link rel="stylesheet" href="~/css/map.css">
    <link rel="stylesheet" href="~/css/footer.css">
    <link rel="stylesheet" href="~/css/SlidingHome.css">
    <link rel="stylesheet" href="~/css/home_Sliding_promos.css">
    <link rel="stylesheet" href="~/css/Admin_Announcement.css">

    <!-- Page-specific head content -->
    <asp:ContentPlaceHolder ID="head" runat="server" />
      <script>
    
          window.isLoggedIn = <%= (Session["UserID"] != null).ToString().ToLower() %>;
      
          function toggleAccountButtons() {
              var loginBtn = document.getElementById("accountBtn");
              var profileItem = document.getElementById("profileNavItem");
              if (!loginBtn || !profileItem) return;

              if (window.isLoggedIn) {
                  loginBtn.style.display = "none";
                  profileItem.style.display = "inline-block";
              } else {
                  loginBtn.style.display = "inline";
                  profileItem.style.display = "none";
              }
          }

          document.addEventListener("DOMContentLoaded", toggleAccountButtons);
          document.addEventListener("DOMContentLoaded", toggleAccountButtons);
          function checkAccount(returnUrl) {
              if (window.isLoggedIn) {
                  window.location.href = '<%= ResolveUrl("~/homepage/profile.aspx") %>';
                  return;
              }

              if (returnUrl) {
                  sessionStorage.setItem("returnUrlAfterLogin", returnUrl);
              } else {
                  sessionStorage.setItem("returnUrlAfterLogin", window.location.href);
              }

              var modalEl = document.getElementById('loginSignupModal');
              var myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
              myModal.show();
          }

          document.addEventListener("DOMContentLoaded", function () {
              toggleAccountButtons();
          });

   
      </script>
</head>

<body class="bg-[#fff] text-[#555] antialiased">

    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <!-- ================= NAVBAR ================= -->
        <header class="site-header">
            <div class="container">
                <a href='<%= ResolveUrl("~/homepage/Home.aspx") %>' class="logo"">
                    <img src='<%= ResolveUrl("~/images/logo.png") %>' alt="Smash-It Logo" />
                    
                    <div class="logo-text-wrapper">
                        <span class="logo-text">SMASH IT</span>
  <span class="under-text">SPORT CENTER</span>
                    </div>                    
                </a>

                <nav class="site-nav">
                    <ul>
                        <li><a href='<%= ResolveUrl("~/homepage/home.aspx") %>'>Home</a></li>
                        <li><a href='<%= ResolveUrl("~/homepage/announcement.aspx") %>'>Announcement</a></li>
                        <li><a href='<%= ResolveUrl("~/homepage/reservation.aspx") %>'>Reservation</a></li>
                        <li><a href='<%= ResolveUrl("~/homepage/about.aspx") %>'>About</a></li>
                        <li><a href='<%= ResolveUrl("~/login.aspx") %>' id="adminBtn">Admin</a></li>
                                       <li><a href="#" id="accountBtn" onclick="checkAccount(); return false;">Login</a></li>

<li id="profileNavItem" style="display:none;">
  <a id="realaccountBtn"
     href='<%= ResolveUrl("~/homepage/profile.aspx") %>'
     style="display:flex;align-items:center;gap:8px;">
     <span>Profile</span>
    <img id="navAvatar"
         src="<%= UserImgUrl %>"
         alt="Profile"
         style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.15);" />
    
  </a>
</li>
                    </ul>
                </nav>
            </div>
        </header>

        <!-- ================= PAGE CONTENT ================= -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- ================= FOOTER ================= -->
        <footer class="site-footer">
            <div class="container">
                <div class="footer-content">

                    <div class="footer-col about">
                        <img class="footer-logo" src='<%= ResolveUrl("~/images/logo.png") %>' alt="Smash-It Logo" />
                        <h3>Smash-It</h3>
                        <p>San Pedro's Sports Center for Badminton & Pickleball</p>
                    </div>

                    <div class="footer-col links">
                        <h3>Quick Links</h3>
                        <ul>
                            <li><a href="#">Rates</a></li>
                            <li><a href="#">Book a Court</a></li>
                            <li><a href="#">Announcements</a></li>
                            <li>Weekdays: 9AM - 10 PM</li>
                            <li>Weekends: 8AM - 10 PM</li>
                        </ul>
                    </div>

                    <div class="footer-col contact">
                        <h3>Contact</h3>
                        <ul>
                            <li><i class="fas fa-phone"></i>+63 917 450 7111</li>
                            <li><i class="fas fa-envelope"></i>smashitsportscenter@gmail.com</li>
                        </ul>

                        <a href="#" class="btn btn-directions">Get Directions</a>

                        <div class="social-icons">
                            <a href="#"><i class="fab fa-facebook-f"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>

                </div>

                <div class="footer-bottom">
                    <p>©Smash-IT Sports Center. All rights reserved.</p>
                    <a href="#" class="back-to-top">Back to the Top <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>
        </footer>
    <uc:AuthModal ID="AuthModal1" runat="server" />

    </form>


    <!-- Global scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src='<%= ResolveUrl("~/js/script.js") %>'></script>
    <script src='<%= ResolveUrl("~/js/dotindicator.js") %>'></script>
    <script src='<%= ResolveUrl("~/js/dotindicator_Promo.js") %>'></script>
    <script src='<%= ResolveUrl("~/js/header_indicator.js") %>'></script>
</body>
</html>
