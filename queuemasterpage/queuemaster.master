<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="queuemaster.master.cs" Inherits="Smash_IT.queuemasterpage.queuemaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receptionist Dashboard | Smash-IT</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: 'Poppins', sans-serif !important;
            background-color: #f4f7fe !important;
            overflow-x: hidden !important;
        }

            body #sidebar.sidebar {
                width: 260px !important;
                background: linear-gradient(180deg, #1e3a8a 0%, #162e70 100%) !important;
                height: 100vh !important;
                position: fixed !important;
                left: 0 !important;
                top: 0 !important;
                display: flex !important;
                flex-direction: column !important;
                z-index: 1000 !important;
                box-shadow: 4px 0 15px rgba(30, 58, 138, 0.1) !important;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
                box-sizing: border-box !important;
            }

            body #sidebar.collapsed {
                width: 75px !important;
            }

            body #sidebar i {
                color: inherit !important;
            }

            body #sidebar .toggle-btn {
                padding: 20px !important;
                color: white !important;
                cursor: pointer !important;
                text-align: right !important;
                opacity: 0.85 !important;
            }

            body #sidebar.collapsed .toggle-btn {
                text-align: center !important;
            }

            body #sidebar .logo-section {
                padding: 10px 25px 30px !important;
                text-align: center !important;
                min-height: 80px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }

                body #sidebar .logo-section img {
                    max-width: 150px !important;
                    height: auto !important;
                    display: block !important;
                }

            body #sidebar.collapsed .logo-section img {
                max-width: 40px !important;
            }

            body #sidebar .menu {
                flex-grow: 1 !important;
                display: flex !important;
                flex-direction: column !important;
                padding: 0 15px !important;
                overflow-y: auto !important;
                scrollbar-width: thin !important;
                scrollbar-color: rgba(255,255,255,0.2) transparent !important;
            }

                body #sidebar .menu::-webkit-scrollbar {
                    width: 4px;
                }

                body #sidebar .menu::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,0.2);
                    border-radius: 10px;
                }

            body #sidebar .menu-label {
                font-size: 0.7rem !important;
                text-transform: uppercase !important;
                color: rgba(255, 255, 255, 0.4) !important;
                letter-spacing: 1.5px !important;
                font-weight: 700 !important;
                padding: 25px 0 10px 15px !important;
                white-space: nowrap !important;
                display: block !important;
            }

            body #sidebar.collapsed .menu-label,<a href="rec_pfa.aspx.designer.cs">rec_pfa.aspx.designer.cs</a>
            body #sidebar.collapsed .user-panel,
            body #sidebar.collapsed .menu a span {
                display: none !important;
            }

            body #sidebar .menu a {
                display: flex !important;
                align-items: center !important;
                padding: 12px 15px !important;
                color: rgba(255, 255, 255, 0.7) !important;
                text-decoration: none !important;
                border-radius: 10px !important;
                margin-bottom: 5px !important;
                transition: all 0.3s ease !important;
                background: transparent !important;
            }

                body #sidebar .menu a i {
                    min-width: 35px !important;
                    font-size: 1.1rem !important;
                }

                body #sidebar .menu a:hover {
                    background: rgba(255, 255, 255, 0.1) !important;
                    color: white !important;
                }

                body #sidebar .menu a.active {
                    background-color: #facc15 !important;
                    color: #1e3a8a !important;
                    font-weight: 700 !important;
                    opacity: 1 !important;
                }

            body #sidebar.collapsed .menu a {
                justify-content: center !important;
                padding: 12px 0 !important;
            }

            body #sidebar .user-panel {
                padding: 20px !important;
                margin: 15px !important;
                background: rgba(255, 255, 255, 0.05) !important;
                border-radius: 12px !important;
                border: 1px solid rgba(255, 255, 255, 0.1) !important;
            }

            body #sidebar .user-name {
                display: block !important;
                color: white !important;
                font-weight: 600 !important;
                font-size: 0.9rem !important;
            }

            body #sidebar .user-role {
                display: block !important;
                color: rgba(255, 255, 255, 0.5) !important;
                font-size: 0.75rem !important;
            }

            body #sidebar .signout-btn {
                margin-top: 15px !important;
                display: flex !important;
                align-items: center !important;
                gap: 10px !important;
                color: #f87171 !important;
                text-decoration: none !important;
                font-size: 0.85rem !important;
                font-weight: 600 !important;
                background: none !important;
                border: none !important;
                cursor: pointer !important;
            }

        .main-wrapper {
            margin-left: 260px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

            .main-wrapper.expanded {
                margin-left: 75px;
            }

        .main-content-container {
            padding: 20px;
            flex: 1;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <aside class="sidebar" id="sidebar" runat="server" clientidmode="Static">
            <div class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars" id="toggleIcon"></i>
            </div>

            <div class="logo-section">
                <a href='<%= ResolveUrl("~/receptionistpage/rec_pfa.aspx") %>'>
                    <asp:Image ID="recLogo" runat="server" ImageUrl="~/Images/logo.png" AlternateText="Logo" />
                </a>
            </div>

            <nav class="menu" id="sidebarMenu" runat="server" clientidmode="Static">
                <div class="menu-label">Main</div>
                <asp:HyperLink ID="navDashboard" runat="server" NavigateUrl="~/receptionistpage/receptionist_dashboard.aspx" ToolTip="Dashboard">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </asp:HyperLink>

                <div class="menu-label">Reception</div>
                <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/receptionistpage/rec_pfa.aspx" ToolTip="Play For All">
                    <i class="fas fa-person-running"></i> <span>Play For All</span>
                </asp:HyperLink>

                <asp:HyperLink ID="navReservations" runat="server" NavigateUrl="~/receptionistpage/rec_res.aspx" ToolTip="Reservations">
                    <i class="fas fa-calendar-check"></i> <span>Reservations</span>
                </asp:HyperLink>

                <asp:HyperLink ID="navQueue" runat="server" NavigateUrl="~/receptionistpage/rec_queue.aspx" ToolTip="Queue">
                    <i class="fas fa-list-ol"></i> <span>Queue</span>
                </asp:HyperLink>
                      
                 <div class="menu-label">Court</div>
                <asp:HyperLink ID="navCourt" runat="server" NavigateUrl="~/receptionistpage/rec_court_override.aspx" ToolTip="Manage Court">
                    <i class="fas fa-table-tennis-paddle-ball"></i> <span>Manage Court</span>
                </asp:HyperLink>
      <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/receptionistpage/rec_live_courts.aspx" ToolTip="Live Court">
     <i class="fas fa-table-tennis-paddle-ball"></i> <span>Live Court</span>
 </asp:HyperLink>
            </nav>

            <div class="user-panel">
                <div class="user-info">
                    <asp:Label ID="lblFullName" runat="server" CssClass="user-name" Text="Receptionist User" />
                    <asp:Label ID="lblRole" runat="server" CssClass="user-role" Text="Receptionist" />
                </div>

                <asp:LinkButton ID="btnLogout" runat="server" CssClass="signout-btn" OnClick="btnLogout_Click">
                    <i class="fas fa-sign-out-alt"></i> <span>Sign Out</span>
                </asp:LinkButton>
            </div>
        </aside>

        <div class="main-wrapper" id="mainWrapper">
            <div class="main-content-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

        <script>
            const sidebar = document.getElementById('sidebar');
            const sidebarMenu = document.getElementById('sidebarMenu');
            const wrapper = document.getElementById('mainWrapper');
            const icon = document.getElementById('toggleIcon');

            function toggleSidebar() {
                sidebar.classList.toggle('collapsed');
                wrapper.classList.toggle('expanded');

                const isCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('recSidebarState', isCollapsed ? 'collapsed' : 'expanded');

                if (isCollapsed) {
                    icon.classList.replace('fa-bars', 'fa-chevron-right');
                } else {
                    icon.classList.replace('fa-chevron-right', 'fa-bars');
                }
            }

            window.addEventListener('load', () => {
                const savedState = localStorage.getItem('recSidebarState');
                if (savedState === 'collapsed') {
                    sidebar.classList.add('collapsed');
                    wrapper.classList.add('expanded');
                    if (icon) icon.classList.replace('fa-bars', 'fa-chevron-right');
                }

                const sidebarScroll = localStorage.getItem('recSidebarScrollPos');
                if (sidebarScroll && sidebarMenu) {
                    sidebarMenu.scrollTop = sidebarScroll;
                }

                const windowScroll = localStorage.getItem('recWindowScrollPos');
                if (windowScroll) {
                    window.scrollTo(0, windowScroll);
                }
            });

            if (sidebarMenu) {
                sidebarMenu.addEventListener('scroll', () => {
                    localStorage.setItem('recSidebarScrollPos', sidebarMenu.scrollTop);
                });
            }

            window.addEventListener('scroll', () => {
                localStorage.setItem('recWindowScrollPos', window.scrollY);
            });
        </script>
    </form>
</body>
</html>
