<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="queuemaster.master.cs" Inherits="Smash_IT.queuemasterpage.queuemaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Queue Master Dashboard | Smash-IT</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
     html,body{height:100%;margin:0;padding:0;font-family:'Poppins',sans-serif;background-color:#f4f7fe;overflow-x:hidden;}

body #sidebar.sidebar{width:260px;background:linear-gradient(180deg,#1e3a8a 0%,#162e70 100%);height:100vh;position:fixed;left:0;top:0;display:flex;flex-direction:column;z-index:1000;box-shadow:4px 0 15px rgba(30,58,138,.1);transition:all .3s cubic-bezier(.4,0,.2,1);box-sizing:border-box;}

body #sidebar.collapsed{width:75px;}

body #sidebar i{color:inherit;}

body #sidebar .toggle-btn{padding:20px;color:#fff;cursor:pointer;text-align:right;opacity:.85;}

body #sidebar.collapsed .toggle-btn{text-align:center;}

body #sidebar .toggle-btn i{font-size:1.2rem;display:inline-block;}

body #sidebar .logo-section{padding:10px 25px 30px;text-align:center;min-height:80px;display:flex;align-items:center;justify-content:center;}

body #sidebar .logo-section img{max-width:150px;height:auto;display:block;}

body #sidebar.collapsed .logo-section img{max-width:40px;}

body #sidebar .menu{flex-grow:1;display:flex;flex-direction:column;padding:0 15px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent;}

body #sidebar .menu::-webkit-scrollbar{width:4px;}

body #sidebar .menu::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:10px;}

body #sidebar .menu-label{font-size:.7rem;text-transform:uppercase;color:rgba(255,255,255,.4);letter-spacing:1.5px;font-weight:700;padding:25px 0 10px 15px;white-space:nowrap;display:block;}

body #sidebar.collapsed .menu-label,
body #sidebar.collapsed .user-panel,
body #sidebar.collapsed .menu a span{display:none;}

body #sidebar .menu a{display:flex;align-items:center;gap:12px;padding:12px 15px;color:rgba(255,255,255,.7);text-decoration:none;border-radius:10px;margin-bottom:5px;transition:all .3s ease;background:transparent;}

body #sidebar .menu a i{min-width:35px;font-size:1.1rem;text-align:center;}

body #sidebar .menu a:hover{background:rgba(255,255,255,.1);color:#fff;}

body #sidebar .menu a.active{background-color:#facc15;color:#1e3a8a;font-weight:700;opacity:1;}

body #sidebar.collapsed .menu a{justify-content:center;padding:12px 0;}

body #sidebar.collapsed .menu a i{min-width:0;margin:0;}

body #sidebar .user-panel{padding:20px;margin:15px;background:rgba(255,255,255,.05);border-radius:12px;border:1px solid rgba(255,255,255,.1);}

body #sidebar .user-name{display:block;color:#fff;font-weight:600;font-size:.9rem;}

body #sidebar .user-role{display:block;color:rgba(255,255,255,.5);font-size:.75rem;}

body #sidebar .signout-btn{margin-top:15px;display:flex;align-items:center;gap:10px;color:#f87171;text-decoration:none;font-size:.85rem;font-weight:600;background:none;border:none;cursor:pointer;}

.main-wrapper{margin-left:260px;transition:all .3s cubic-bezier(.4,0,.2,1);min-height:100vh;display:flex;flex-direction:column;position:relative;}

.main-wrapper.expanded{margin-left:75px;}

.main-content-container{padding:20px;flex:1;}
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <aside class="sidebar" id="sidebar" runat="server" clientidmode="Static">
            <div class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars" id="toggleIcon"></i>
            </div>

    

            <nav class="menu" id="sidebarMenu" runat="server" clientidmode="Static">
                <div class="menu-label">Main</div>
                <asp:HyperLink ID="navDashboard" runat="server" NavigateUrl="~/queuemasterpage/q_dashboard.aspx" ToolTip="Dashboard">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </asp:HyperLink>

           

                <asp:HyperLink ID="navQueue" runat="server" NavigateUrl="~/queuemasterpage/q_live_court.aspx" ToolTip="Live Court">
                    <i class="fas fa-list-ol"></i> <span>Live Court</span>
                </asp:HyperLink>
                      
                 <div class="menu-label">Court</div>
                <asp:HyperLink ID="navCourt" runat="server" NavigateUrl="~/queuemasterpage/q_queue.aspx" ToolTip="Manage Queue">
                    <i class="fas fa-table-tennis-paddle-ball"></i> <span> Queue</span>
                </asp:HyperLink>
      <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/queuemasterpage/q_manage_queue.aspx" ToolTip="Manage Queue">
     <i class="fas fa-table-tennis-paddle-ball"></i> <span> Matches </span>
 </asp:HyperLink>
            </nav>

            <div class="user-panel">
                <div class="user-info">
                    <asp:Label ID="lblFullName" runat="server" CssClass="user-name" Text="Queue Master" />
                    <asp:Label ID="lblRole" runat="server" CssClass="user-role" Text="Queue Master" />
                </div>

                <asp:LinkButton ID="btnLogout" runat="server" CssClass="signout-btn" OnClick="btnLogout_Click">
                    <i class="fas fa-sign-out-alt"></i> <span>Sign Out</span>
                </asp:LinkButton>
            </div>
        </aside>

        <div class="main-wrapper" id="mainWrapper">
            <div class="main-content-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

        <script>
            const sidebar = document.getElementById('sidebar');
            const sidebarMenu = document.getElementById('sidebarMenu');
            const wrapper = document.getElementById('mainWrapper');
            const icon = document.getElementById('toggleIcon');

            function toggleSidebar() {
                sidebar.classList.toggle('collapsed');
                wrapper.classList.toggle('expanded');

                const isCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('recSidebarState', isCollapsed ? 'collapsed' : 'expanded');

                if (isCollapsed) {
                    icon.classList.replace('fa-bars', 'fa-chevron-right');
                } else {
                    icon.classList.replace('fa-chevron-right', 'fa-bars');
                }
            }

            window.addEventListener('load', () => {
                const savedState = localStorage.getItem('recSidebarState');
                if (savedState === 'collapsed') {
                    sidebar.classList.add('collapsed');
                    wrapper.classList.add('expanded');
                    if (icon) icon.classList.replace('fa-bars', 'fa-chevron-right');
                }

                const sidebarScroll = localStorage.getItem('recSidebarScrollPos');
                if (sidebarScroll && sidebarMenu) {
                    sidebarMenu.scrollTop = sidebarScroll;
                }

                const windowScroll = localStorage.getItem('recWindowScrollPos');
                if (windowScroll) {
                    window.scrollTo(0, windowScroll);
                }
            });

            if (sidebarMenu) {
                sidebarMenu.addEventListener('scroll', () => {
                    localStorage.setItem('recSidebarScrollPos', sidebarMenu.scrollTop);
                });
            }

            window.addEventListener('scroll', () => {
                localStorage.setItem('recWindowScrollPos', window.scrollY);
            });
        </script>
    </form>
</body>
</html>
