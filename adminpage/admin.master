<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admin.master.cs" Inherits="Smash_IT.adminpage.admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Smash-IT</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        /* ===== 1. GLOBAL PROTECTION & RESET ===== */
        /* These ensure the Staff CSS '*' reset doesn't break the Master layout */
        html, body {
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: 'Poppins', sans-serif !important;
            background-color: #f4f7fe !important;
            overflow-x: hidden !important;
        }

        /* ===== 2. SIDEBAR CORE (High Specificity) ===== */
        body #sidebar.sidebar {
            width: 260px !important;
            background: linear-gradient(180deg, #1e3a8a 0%, #162e70 100%) !important;
            height: 100vh !important;
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            z-index: 1000 !important;
            box-shadow: 4px 0 15px rgba(30, 58, 138, 0.1) !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-sizing: border-box !important;
        }

        body #sidebar.collapsed { width: 75px !important; }

        /* Force icon colors to stay white/yellow regardless of external link CSS */
        body #sidebar i {
            color: inherit !important;
            font-style: normal !important;
        }

        body #sidebar .toggle-btn {
            padding: 20px !important;
            color: white !important;
            cursor: pointer !important;
            text-align: right !important;
            opacity: 0.8 !important;
        }

        body #sidebar.collapsed .toggle-btn { text-align: center !important; }

        /* ===== 3. LOGO SECTION ===== */
        body #sidebar .logo-section {
            padding: 10px 25px 30px !important;
            text-align: center !important;
            min-height: 80px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        body #sidebar .logo-section img {
            max-width: 150px !important;
            height: auto !important;
            display: block !important;
        }

        body #sidebar.collapsed .logo-section img { max-width: 40px !important; }

        /* ===== 4. NAVIGATION MENU & SCROLLBAR ===== */
        body #sidebar .menu {
            flex-grow: 1 !important;
            display: flex !important;
            flex-direction: column !important;
            padding: 0 15px !important;
            overflow-y: auto !important; /* This allows the menu to scroll if it gets too long */
            scrollbar-width: thin !important;
            scrollbar-color: rgba(255,255,255,0.2) transparent !important;
        }

        /* Custom Scrollbar for Chrome/Safari */
        body #sidebar .menu::-webkit-scrollbar { width: 4px; }
        body #sidebar .menu::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

        body #sidebar .menu-label {
            font-size: 0.7rem !important;
            text-transform: uppercase !important;
            color: rgba(255, 255, 255, 0.4) !important;
            letter-spacing: 1.5px !important;
            font-weight: 700 !important;
            padding: 25px 0 10px 15px !important;
            white-space: nowrap !important;
            display: block !important;
        }

        /* Hide text elements when collapsed */
        body #sidebar.collapsed .menu-label,
        body #sidebar.collapsed .user-panel,
        body #sidebar.collapsed .menu a span { display: none !important; }

        body #sidebar .menu a {
            display: flex !important;
            align-items: center !important;
            padding: 12px 15px !important;
            color: rgba(255, 255, 255, 0.7) !important;
            text-decoration: none !important;
            border-radius: 10px !important;
            margin-bottom: 5px !important;
            transition: all 0.3s ease !important;
            background: transparent !important;
        }

        body #sidebar .menu a i { min-width: 35px !important; font-size: 1.1rem !important; }
        
        body #sidebar .menu a:hover { 
            background: rgba(255, 255, 255, 0.1) !important; 
            color: white !important; 
        }

        /* ACTIVE STATE PROTECTION */
        body #sidebar .menu a.active {
            background-color: #facc15 !important;
            color: #1e3a8a !important;
            font-weight: 700 !important;
            opacity: 1 !important;
        }

        body #sidebar.collapsed .menu a { justify-content: center !important; padding: 12px 0 !important; }

        /* ===== 5. USER PANEL ===== */
        body #sidebar .user-panel {
            padding: 20px !important;
            margin: 15px !important;
            background: rgba(255, 255, 255, 0.05) !important;
            border-radius: 12px !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

        body #sidebar .user-name { display: block !important; color: white !important; font-weight: 600 !important; font-size: 0.9rem !important; }
        body #sidebar .user-role { display: block !important; color: rgba(255, 255, 255, 0.5) !important; font-size: 0.75rem !important; }

        body #sidebar .signout-btn {
            margin-top: 15px !important;
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
            color: #f87171 !important;
            text-decoration: none !important;
            font-size: 0.85rem !important;
            font-weight: 600 !important;
            background: none !important;
            border: none !important;
        }

        /* ===== 6. MAIN CONTENT WRAPPER ===== */
        .main-wrapper {
            margin-left: 260px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .main-wrapper.expanded { margin-left: 75px; }
        .main-content-container { padding: 20px; flex: 1; }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form runat="server">
        <aside class="sidebar" id="sidebar" runat="server" clientidmode="Static">
            <div class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars" id="toggleIcon"></i>
            </div>

            <div class="logo-section">
                <a href='<%= ResolveUrl("~/adminpage/admin_dashboard.aspx") %>'>
                    <asp:Image ID="adminLogo" runat="server" ImageUrl="~/images/logo.png" AlternateText="Logo" />
                </a>
            </div>

            <nav class="menu" id="sidebarMenu" runat="server" clientidmode="Static">
                <div class="menu-label">Main</div>
                <asp:HyperLink ID="navDashboard" runat="server" NavigateUrl="~/adminpage/admin_dashboard.aspx" ToolTip="Dashboard">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navAnalytics" runat="server" NavigateUrl="~/adminpage/admin_analytics.aspx" ToolTip="Analytics">
                    <i class="fas fa-chart-line"></i> <span>Analytics</span>
                </asp:HyperLink>

                <div class="menu-label">Operations</div>
                <asp:HyperLink ID="navCourts" runat="server" NavigateUrl="~/adminpage/admin_court.aspx" ToolTip="Courts">
                    <i class="fas fa-table-tennis-paddle-ball"></i> <span>Manage Courts</span>
                </asp:HyperLink>
                     <asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="~/adminpage/admin_court_override.aspx" ToolTip="Courts">
         <i class="fas fa-table-tennis-paddle-ball"></i> <span>Court Availability</span>
     </asp:HyperLink>
                <asp:HyperLink ID="navPlayForAll" runat="server" NavigateUrl="~/adminpage/admin_playallyoucan.aspx" ToolTip="Play-All">
                    <i class="fas fa-person-running"></i> <span>Play-All-You-Can</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navQueue" runat="server" NavigateUrl="~/adminpage/admin_queue.aspx" ToolTip="Queue">
                    <i class="fas fa-list-ol"></i> <span>Manage Event</span>
                </asp:HyperLink>
                <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/adminpage/admin_manage_queue.aspx" ToolTip="Queue">
                    <i class="fas fa-list-ol"></i> <span>Manage Queue</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navReservation" runat="server" NavigateUrl="~/adminpage/admin_reservation.aspx" ToolTip="Reservations">
                    <i class="fas fa-calendar-check"></i> <span>Reservations</span>
                </asp:HyperLink> 

                <div class="menu-label">Finances & Assets</div>
                <asp:HyperLink ID="navPayments" runat="server" NavigateUrl="~/adminpage/admin_transactions.aspx" ToolTip="Transactions">
                    <i class="fas fa-file-invoice-dollar"></i> <span>Transactions</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navInventory" runat="server" NavigateUrl="~/adminpage/admin_inventory.aspx" ToolTip="Inventory">
                    <i class="fas fa-boxes-stacked"></i> <span>Inventory</span>
                </asp:HyperLink>

                <div class="menu-label">System</div>
                <asp:HyperLink ID="navAnnouncement" runat="server" NavigateUrl="~/adminpage/Content_Manager.aspx" ToolTip="Announcements">
                    <i class="fas fa-bullhorn"></i> <span>Announcements</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navCustomerAccount" runat="server" NavigateUrl="~/adminpage/admin_customer_account.aspx" ToolTip="Customers">
                    <i class="fas fa-users"></i> <span>Customer Accounts</span>
                </asp:HyperLink>
                <asp:HyperLink ID="navUsers" runat="server" NavigateUrl="~/adminpage/admin_users.aspx" ToolTip="Staff">
                    <i class="fas fa-user-shield"></i> <span>Staff Management</span>
                </asp:HyperLink>
            </nav>

            <div class="user-panel">
                <div class="user-info">
                    <asp:Label ID="lblFullName" runat="server" CssClass="user-name" Text="Admin User" />
                    <asp:Label ID="lblRole" runat="server" CssClass="user-role" Text="Staff" />
                </div>
                <asp:LinkButton ID="btnLogout" runat="server" CssClass="signout-btn" OnClick="btnLogout_Click">
                    <i class="fas fa-sign-out-alt"></i> <span>Sign Out</span>
                </asp:LinkButton>
            </div>
        </aside>

        <div class="main-wrapper" id="mainWrapper">
            <div class="main-content-container">
            
    
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

        <script>
            // Use Static IDs defined in the elements above
            const sidebar = document.getElementById('sidebar');
            const sidebarMenu = document.getElementById('sidebarMenu');
            const wrapper = document.getElementById('mainWrapper');
            const icon = document.getElementById('toggleIcon');

            function toggleSidebar() {
                sidebar.classList.toggle('collapsed');
                wrapper.classList.toggle('expanded');
                const isCollapsed = sidebar.classList.contains('collapsed');

                // Save state
                localStorage.setItem('sidebarState', isCollapsed ? 'collapsed' : 'expanded');

                // Update Icon
                if (isCollapsed) {
                    icon.classList.replace('fa-bars', 'fa-chevron-right');
                } else {
                    icon.classList.replace('fa-chevron-right', 'fa-bars');
                }
            }

            // Restore Scroll and Sidebar State on Page Load
            window.addEventListener('load', () => {
                // 1. Restore Sidebar State
                const savedState = localStorage.getItem('sidebarState');
                if (savedState === 'collapsed') {
                    sidebar.classList.add('collapsed');
                    wrapper.classList.add('expanded');
                    if (icon) icon.classList.replace('fa-bars', 'fa-chevron-right');
                }

                // 2. Restore Sidebar Scroll Position
                const sidebarScroll = localStorage.getItem('sidebarScrollPos');
                if (sidebarScroll && sidebarMenu) {
                    sidebarMenu.scrollTop = sidebarScroll;
                }

                // 3. Restore Window Scroll Position
                const windowScroll = localStorage.getItem('windowScrollPos');
                if (windowScroll) window.scrollTo(0, windowScroll);
            });

            // Listen for scrolling to save position
            if (sidebarMenu) {
                sidebarMenu.addEventListener('scroll', () => {
                    localStorage.setItem('sidebarScrollPos', sidebarMenu.scrollTop);
                });
            }

            window.addEventListener('scroll', () => {
                localStorage.setItem('windowScrollPos', window.scrollY);
            });
        </script>
    </form>
</body>
</html>